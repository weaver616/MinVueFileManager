# MinIO 基础配置
VITE_MINIO_ENDPOINT=127.0.0.1
VITE_MINIO_PORT=9000
VITE_MINIO_USE_SSL=false
VITE_MINIO_ACCESS_KEY=yjs_testj4
VITE_MINIO_SECRET_KEY=yjs_passwordj4
VITE_MINIO_BUCKET_NAME=datalb

# 可选：如果想显式用 S3 命名，也可以写这一组（两者任选其一）
# VITE_S3_ENDPOINT=http://127.0.0.1:9000
# VITE_S3_ACCESS_KEY=yjs_testj4
# VITE_S3_SECRET_KEY=yjs_passwordj4
# VITE_S3_REGION=us-east-1
# VITE_S3_BUCKET_NAME=datalb
# VITE_S3_FORCE_PATH_STYLE=true
VITE_APP_PLAT_TYPE = '4C'
# TODO: 子应用名字，一定要保证正确
VITE_APP_NAME = 'MMHR'
VITE_APP_NODE_ENV = 'development'
# VITE_APP_BASE_API = 'http://10.25.145.89:10003/'
# VITE_APP_BASE_API = 'http://192.168.13.50:10003/'
VITE_APP_BASE_API = 'http://192.168.13.50:10003/' 
# TODO: 语言 zh_Hans, en, ar
VITE_APP_LANG = 'zh_Hans'

